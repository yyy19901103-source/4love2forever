{
  "name": "quality-kit",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript の特徴を示す品質統計ツール (Cp/Cpk, EWMA, CUSUM, Hampel)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/bin.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'tests/*.test.ts'",
    "test": "npm run typecheck && npm run test:unit",
    "start": "node src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
